{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tin-whistle-note-source-api",
  "main": "worker/source-api.mjs",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "AUDIO_RATE_LIMITER",
      "namespace_id": "2026090601",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "BPM_DB",
      "database_name": "tin-whistle-note-tempos",
      "database_id": "6867e22d-28be-40d1-9fde-8499fde9bd6d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUDIO_ALLOWED_HOSTS": "upload.wikimedia.org",
    "ALLOWED_ORIGINS": "https://ozguregemen.github.io",
    "GITHUB_REPOSITORY": "ozguregemen/tin-whistle-note-creator",
    "GITHUB_RESULT_REF": "main"
  }
}
