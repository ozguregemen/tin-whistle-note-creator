{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tin-whistle-note-source-api",
  "main": "worker/source-api.mjs",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vpc_services": [
    {
      "binding": "AUDIO_ORIGIN",
      "service_id": "01a1f593-cad4-7881-b06d-f6fb0963b104"
    }
  ],
  "ratelimits": [
    {
      "name": "AUDIO_RATE_LIMITER",
      "namespace_id": "2026090601",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "BPM_DB",
      "database_name": "tin-whistle-note-tempos",
      "database_id": "6867e22d-28be-40d1-9fde-8499fde9bd6d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUDIO_ALLOWED_HOSTS": "upload.wikimedia.org",
    "ALLOWED_ORIGINS": "https://ozguregemen.github.io",
    "AUDIO_SERVICE_ORIGINS": "https://nefes-tin-whistle.ozguregemenbusiness.chatgpt.site",
    "SCORE_SOURCE_ORIGINS": "https://nefes-tin-whistle.ozguregemenbusiness.chatgpt.site",
    "MOBILE_APP_ORIGINS": "https://localhost,capacitor://localhost",
    "GITHUB_REPOSITORY": "ozguregemen/tin-whistle-note-creator",
    "GITHUB_RESULT_REF": "main"
  },
  "env": {
    // Mobile app test copy: npx wrangler deploy --config wrangler.source-api.jsonc --env staging
    // It has no GITHUB_TOKEN secret, so it can never queue a job that commits to main
    // (/api/jobs and /api/catalog answer with an error and the app keeps its bundled catalog).
    // It has no BPM_DB, so it never writes the production tempo cache.
    "staging": {
      "name": "tin-whistle-note-source-api-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vpc_services": [
        {
          "binding": "AUDIO_ORIGIN",
          "service_id": "01a1f593-cad4-7881-b06d-f6fb0963b104"
        }
      ],
      "d1_databases": [],
      "ratelimits": [
        {
          "name": "AUDIO_RATE_LIMITER",
          "namespace_id": "2026112201",
          "simple": { "limit": 6, "period": 60 }
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "vars": {
        "AUDIO_ALLOWED_HOSTS": "upload.wikimedia.org",
        "ALLOWED_ORIGINS": "https://ozguregemen.github.io",
        "AUDIO_SERVICE_ORIGINS": "",
        "SCORE_SOURCE_ORIGINS": "",
        "MOBILE_APP_ORIGINS": "https://localhost,capacitor://localhost",
        "GITHUB_REPOSITORY": "ozguregemen/tin-whistle-note-creator",
        "GITHUB_RESULT_REF": "main"
      }
    }
  }
}
