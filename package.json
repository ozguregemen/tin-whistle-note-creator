{
  "name": "tin-whistle-note-creator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prepare:audio-model": "node scripts/copy-basic-pitch-model.mjs",
    "build": "npm run prepare:audio-model && vinext build",
    "build:pages": "npm run prepare:audio-model && vite build --config vite.pages.config.ts",
    "build:mobile": "npm run prepare:audio-model && vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run build:mobile && cap sync android",
    "android:apk": "npm run mobile:sync && node scripts/android-gradle.mjs assembleDebug",
    "build:mobile:staging": "npm run prepare:audio-model && vite build --config vite.mobile.config.ts --mode staging",
    "android:apk:staging": "npm run build:mobile:staging && cap sync android && node scripts/android-gradle.mjs assembleDebug",
    "worker:staging:deploy": "wrangler deploy --config wrangler.source-api.jsonc --env staging",
    "community:staging:deploy": "wrangler deploy --config wrangler.community.jsonc --env staging",
    "smoke:community": "node scripts/community-smoke.mjs",
    "moderate": "node scripts/community-moderate.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "store:graphics": "node scripts/store-graphics.mjs",
    "android:aab": "npm run mobile:sync && node scripts/android-gradle.mjs bundleRelease",
    "ios:sync": "npm run build:mobile && node scripts/set-ios-version.mjs && cap sync ios",
    "preview:mobile": "vite preview --config vite.mobile.config.ts",
    "sync:sources": "node scripts/sync-note-sources.mjs",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "eval:melody": "node scripts/evaluate-melody.mjs",
    "curate:tempos": "node scripts/apply-curated-tempos.mjs",
    "worker:dev": "wrangler dev --config wrangler.source-api.jsonc",
    "worker:check": "wrangler deploy --dry-run --config wrangler.source-api.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.source-api.jsonc",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@coderline/alphatab": "^1.8.4",
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
